# 9X-AI Environment Configuration
# Copy this file to .env and fill in your values

# Target web application URL
BASE_URL="https://www.veergame41.com/#/saasLottery/WinGo?gameCode=WinGo_30S&lottery=WinGo"

# Browser settings
HEADLESS=false
USER_DATA_DIR=./user_data

# Timing gatekeeper boundaries (seconds)
MIN_TIMING_WINDOW_SEC=10
MAX_TIMING_WINDOW_SEC=25

# DOM polling interval (milliseconds)
POLL_INTERVAL_MS=250

# Safety circuit breaker: minimum wallet balance before HALT
STOP_LOSS_BALANCE=0.0

# Maximum consecutive DOM desync errors before HALT (20 x 250ms = 5s grace window)
MAX_DESYNC_RETRIES=20
