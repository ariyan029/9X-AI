{
  "current_round_id": {
    "css": ".TimeLeft__C-id, div[class*='TimeLeft__C-id']",
    "xpath": "//div[contains(@class, 'TimeLeft__C-id')]",
    "description": "Unique round identifier for the active cycle"
  },
  "countdown_timer_seconds": {
    "css": ".TimeLeft__C-time, div[class*='TimeLeft__C-time']",
    "xpath": "//div[contains(@class, 'TimeLeft__C-time')]",
    "description": "Countdown timer displaying seconds remaining (00 to 30)"
  },
  "history_table_rows": {
    "css": ".GameRecord__C-body .van-row",
    "xpath": "//div[contains(@class, 'GameRecord__C-body')]//div[contains(@class, 'van-row')]",
    "description": "List of finished round result rows"
  },
  "history_row_round_id": {
    "css": ".van-col--9, div:first-child",
    "xpath": ".//div[1]",
    "description": "Round ID column within a history row"
  },
  "history_row_result_number": {
    "css": ".GameRecord__C-body-num",
    "xpath": ".//div[contains(@class, 'GameRecord__C-body-num')]",
    "description": "Result number (0-9)"
  },
  "history_row_result_outcome": {
    "css": ".van-col:nth-child(3) span",
    "xpath": ".//div[3]//span",
    "description": "Label indicating 'Big' or 'Small'"
  },
  "bet_button_big": {
    "css": ".Betting__C-foot-b",
    "xpath": "//div[contains(@class, 'Betting__C-foot-b')]",
    "description": "Selection button for Big outcome"
  },
  "bet_button_small": {
    "css": ".Betting__C-foot-s",
    "xpath": "//div[contains(@class, 'Betting__C-foot-s')]",
    "description": "Selection button for Small outcome"
  },
  "amount_input_field": {
    "css": "input.van-field__control, .Betting__Popup-input input",
    "xpath": "//input[contains(@class, 'van-field__control')]",
    "description": "Input field to enter custom bet stake"
  },
  "confirm_bet_button": {
    "css": ".Betting__Popup-foot-s, div[class*='Betting__Popup-foot-s']",
    "xpath": "//div[contains(@class, 'Betting__Popup-foot-s')]",
    "description": "Submission button to commit bet order"
  },
  "wallet_balance_display": {
    "css": ".Wallet__C-balance-l1, div[class*='Wallet__C-balance-l1']",
    "xpath": "//div[contains(@class, 'Wallet__C-balance-l1')]",
    "description": "Real-time user account balance for risk validation"
  },
  "bet_success_toast": {
    "css": "div.van-toast, div[class*='toast']",
    "xpath": "//div[contains(@class, 'van-toast')]",
    "description": "Notification element indicating successful bet placement"
  },
  "bet_error_toast": {
    "css": "div.toast-fail, div.van-toast--fail, div[role='alert'].error",
    "xpath": "//div[contains(@class, 'toast') and (contains(@class, 'fail') or contains(@class, 'error'))]",
    "description": "Notification element indicating rejected bet"
  }
}

